<Window x:Class="TelaRec.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TelaRec" Icon="Assets/icon.ico" Width="900" Height="760" MinWidth="720" MinHeight="620"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="Segoe UI" FontSize="14" WindowStartupLocation="CenterScreen">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho: estado + cronômetro -->
        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse x:Name="StatusDot" Width="14" Height="14" Fill="{StaticResource Green}" VerticalAlignment="Center"/>
                <TextBlock x:Name="StatusText" Text="Pronto para gravar" FontSize="17" FontWeight="SemiBold"
                           Margin="12,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock x:Name="TimerText" Text="00:00:00" FontSize="42" FontWeight="Light"
                       FontFamily="Consolas" HorizontalAlignment="Right"/>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,20,0,0">
            <StackPanel Margin="0,0,10,0">

                <TextBlock Text="TELA A GRAVAR" Foreground="{StaticResource Muted}" FontSize="12" FontWeight="SemiBold" Margin="2,0,0,8"/>
                <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1"
                        CornerRadius="14" Padding="16">
                    <StackPanel>
                        <Grid x:Name="LayoutHost" Height="250" SizeChanged="LayoutHost_SizeChanged">
                            <Canvas x:Name="MonitorCanvas"/>
                        </Grid>
                        <Grid Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock x:Name="SelectedInfo" FontWeight="SemiBold"/>
                                <TextBlock x:Name="SelectedInfo2" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button x:Name="RefreshButton" Content="Atualizar lista" Style="{StaticResource GhostBtn}"
                                    Height="34" MinWidth="120" FontSize="13" HorizontalAlignment="Right"
                                    VerticalAlignment="Center" Click="RefreshButton_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Text="CONFIGURAÇÕES" Foreground="{StaticResource Muted}" FontSize="12" FontWeight="SemiBold" Margin="2,20,0,8"/>
                <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1"
                        CornerRadius="14" Padding="16">
                    <Grid x:Name="SettingsPanel">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Pasta de destino" VerticalAlignment="Center" Margin="0,0,0,12"/>
                        <Grid Grid.Row="0" Grid.Column="1" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="FolderBox" Background="{StaticResource Surface2}" Foreground="{StaticResource Text}"
                                     BorderBrush="{StaticResource Border}" CaretBrush="White" Padding="8,7"/>
                            <Button Grid.Column="1" x:Name="BrowseButton" Content="Procurar…" Style="{StaticResource GhostBtn}"
                                    Height="34" MinWidth="100" FontSize="13" Margin="8,0,0,0" Click="BrowseButton_Click"/>
                        </Grid>

                        <TextBlock Grid.Row="1" Text="Nome do arquivo" VerticalAlignment="Center" Margin="0,0,0,12"/>
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="NameBox" Margin="0,0,0,12"
                                 Background="{StaticResource Surface2}" Foreground="{StaticResource Text}"
                                 BorderBrush="{StaticResource Border}" CaretBrush="White" Padding="8,7"
                                 ToolTip="Deixe em branco para usar data e hora automaticamente"/>

                        <TextBlock Grid.Row="2" Text="Taxa de quadros" VerticalAlignment="Center" Margin="0,0,0,12"/>
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,12">
                            <RadioButton x:Name="Fps30" GroupName="fps" Content="30 FPS" Style="{StaticResource PillRadio}"/>
                            <RadioButton x:Name="Fps60" GroupName="fps" Content="60 FPS" Style="{StaticResource PillRadio}"/>
                        </StackPanel>

                        <TextBlock Grid.Row="3" Text="Qualidade" VerticalAlignment="Center" Margin="0,0,0,12"/>
                        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,12">
                            <RadioButton x:Name="QEco" GroupName="q" Content="Econômica" Style="{StaticResource PillRadio}"/>
                            <RadioButton x:Name="QBal" GroupName="q" Content="Equilibrada" Style="{StaticResource PillRadio}"/>
                            <RadioButton x:Name="QHigh" GroupName="q" Content="Alta" Style="{StaticResource PillRadio}"/>
                        </StackPanel>

                        <TextBlock Grid.Row="4" Text="Opções" VerticalAlignment="Top" Margin="0,2,0,0"/>
                        <StackPanel Grid.Row="4" Grid.Column="1">
                            <CheckBox x:Name="HwCheck" Content="Usar aceleração por hardware quando disponível" Foreground="{StaticResource Text}" Margin="0,0,0,6"/>
                            <CheckBox x:Name="HideCheck" Content="Esconder esta janela da gravação" Foreground="{StaticResource Text}" Margin="0,0,0,6"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <CheckBox x:Name="ClickFxCheck" VerticalAlignment="Center" Foreground="{StaticResource Text}"
                                          Content="Efeito de clique do mouse"
                                          ToolTip="Mostra um círculo colorido no ponto de cada clique (azul = esquerdo, laranja = direito)"/>
                                <Button x:Name="ClickHelpButton" Content="?" Style="{StaticResource HelpBtn}" Margin="10,0,0,0"
                                        ToolTip="Como funciona o efeito de clique" Click="ClickHelpButton_Click"/>
                                <Popup x:Name="ClickHelpPopup" PlacementTarget="{Binding ElementName=ClickHelpButton}"
                                       Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                                    <Border Background="{StaticResource Surface2}" BorderBrush="{StaticResource Accent}"
                                            BorderThickness="1" CornerRadius="12" Padding="16" Width="360" Margin="0,6,14,14"
                                            TextElement.Foreground="{StaticResource Text}">
                                        <StackPanel>
                                            <TextBlock Text="Efeito de clique" FontWeight="SemiBold" FontSize="15"/>
                                            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,6,0,12"
                                                       Text="Desenha um círculo animado no ponto exato de cada clique. Ele aparece no vídeo gravado."/>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <Ellipse Width="18" Height="18" Fill="#2F9BFF" Stroke="White" StrokeThickness="1.5" VerticalAlignment="Top"/>
                                                <TextBlock Margin="10,0,0,0" TextWrapping="Wrap" Width="290">
                                                    <Run FontWeight="SemiBold" Text="Botão esquerdo: "/><Run Text="círculo AZUL e som de clique agudo."/>
                                                </TextBlock>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                                <Ellipse Width="18" Height="18" Fill="#FF8A1F" Stroke="White" StrokeThickness="1.5" VerticalAlignment="Top"/>
                                                <TextBlock Margin="10,0,0,0" TextWrapping="Wrap" Width="290">
                                                    <Run FontWeight="SemiBold" Text="Botão direito: "/><Run Text="círculo LARANJA e som de clique mais grave."/>
                                                </TextBlock>
                                            </StackPanel>
                                            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12"
                                                       Text="• Só aparece no monitor que está sendo gravado.&#10;• O som é apenas um aviso para você: o vídeo não grava áudio.&#10;• Cliques feitos durante a pausa não aparecem."/>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </StackPanel>
                            <CheckBox x:Name="ClickSoundCheck" Content="Tocar som ao clicar (somente para você ouvir)" Foreground="{StaticResource Text}" Margin="24,0,0,6"/>
                            <TextBlock x:Name="EncoderInfo" Foreground="{StaticResource Muted}" FontSize="12" Text=""/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border x:Name="MessageBorder" Visibility="Collapsed" Margin="0,18,0,0" CornerRadius="12" Padding="14"
                        Background="{StaticResource Surface2}" BorderBrush="{StaticResource Border}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock x:Name="MessageText" TextWrapping="Wrap"/>
                        <StackPanel x:Name="ActionsPanel" Orientation="Horizontal" Margin="0,10,0,0" Visibility="Collapsed">
                            <Button x:Name="OpenFolderButton" Content="Abrir pasta" Style="{StaticResource GhostBtn}"
                                    Height="34" MinWidth="110" FontSize="13" Margin="0,0,8,0" Click="OpenFolderButton_Click"/>
                            <Button x:Name="PlayButton" Content="Reproduzir" Style="{StaticResource GhostBtn}"
                                    Height="34" MinWidth="110" FontSize="13" Margin="0" Click="PlayButton_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Controles de gravação -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
            <Button x:Name="RecButton" Content="●  Iniciar gravação" Style="{StaticResource PrimaryBtn}" Width="240"
                    IsEnabled="False" Click="RecButton_Click"/>
            <Button x:Name="PauseButton" Content="Pausar" Style="{StaticResource GhostBtn}" Width="160"
                    Visibility="Collapsed" Click="PauseButton_Click"/>
            <Button x:Name="StopButton" Content="■  Finalizar" Style="{StaticResource PrimaryBtn}" Width="180"
                    Visibility="Collapsed" Click="StopButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
